# ─── AI Integration ─────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
# Must be named exactly GOOGLE_GENERATIVE_AI_API_KEY (required by @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ─── GitHub Integration ──────────────────────────────────────────────────────
# Fine-grained PAT from https://github.com/settings/tokens?type=beta
# Required scopes: Contents (read/write), Metadata (read)
GITHUB_TOKEN=your_github_token_here

# ─── Basic Auth (optional but recommended) ───────────────────────────────────
# Protects the entire app with HTTP Basic Auth
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=changeme_use_a_strong_password
